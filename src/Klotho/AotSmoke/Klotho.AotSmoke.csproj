<!--
  Klotho.AotSmoke — publishes as NativeAOT and exercises the bridge paths that need runtime type
  inspection: relation components (which hold an Entity) and Scripts.

  Its point is to prove those paths work with dynamic code disabled. Under NativeAOT
  RuntimeFeature.IsDynamicCodeSupported is false, so DeterministicLayout interprets its plan
  through reflection instead of compiling expression trees. A plain `dotnet test` run cannot
  cover that: the JIT is always available there.

  Publishing (not just building) is the point: the checks only mean something when they run as a
  native binary, where IsDynamicCodeSupported is actually false. The program exits non-zero on the
  first failed check, so it works as a build gate.

  Not part of Engine.sln's default build — publishing AOT needs the C++ toolchain (Visual Studio
  with the C++ workload). ILC invokes `vswhere.exe` without a path, so its install directory must be
  on PATH; otherwise the link fails late with MSB3073 exit 123 and vswhere's own error text spliced
  into the linker path, which reads like a missing toolchain rather than a missing PATH entry.

      PATH="$PATH:/c/Program Files (x86)/Microsoft Visual Studio/Installer" \
        dotnet publish src/Klotho/AotSmoke/Klotho.AotSmoke.csproj -r win-x64 -c Release
      ./src/Klotho/AotSmoke/bin/Release/net8.0/win-x64/publish/Klotho.AotSmoke.exe
      echo $?   # 0 = all checks passed
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AssemblyName>Klotho.AotSmoke</AssemblyName>
    <RootNamespace>Klotho.Friflo.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Surface every trim/AOT warning from the bridge and its dependencies. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge\Klotho.Friflo.Bridge.csproj" />
    <ProjectReference Include="..\..\ECS\Friflo.Engine.ECS.csproj" />
  </ItemGroup>

</Project>
