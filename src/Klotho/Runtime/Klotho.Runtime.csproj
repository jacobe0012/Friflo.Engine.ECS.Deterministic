<!--
  Klotho.Runtime — engine-agnostic Klotho core (ECS, Serialization, Network, Core, Replay,
  Deterministic math/physics, Diagnostics), mirroring the upstream Server~ assembly boundaries.

  Excludes (each is engine/json-coupled or a separate upstream assembly):
    **/Json~/**   DataAsset.Json subtree (Unity/json-coupled)
    Plugins~/**   optional MEL logging adapter (needs Microsoft.Extensions.Logging)

  The `~` suffix is Unity's "do not import" marker: this repository is consumed as a git
  submodule placed under a Unity project's Assets/, where Unity compiles every .cs it finds.
  Directories that must not reach Unity carry the suffix, so the exclude patterns below match
  the on-disk names. Renaming one without updating the other silently pulls the tree back in.

  Unlike upstream, Logging / Gameplay / LiteNetLib / ThirdParty are compiled into this single
  assembly instead of separate ones: the bridge only needs one reference, and KlothoGenerator
  emits its registrations in the assembly holding CommandFactory/MessageSerializer.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Klotho uses unsafe in LowLevel/KUnsafe + LiteNetLib. Scoped to this assembly:
         Friflo.Engine.ECS keeps AllowUnsafeBlocks=false. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Klotho.Runtime</AssemblyName>
    <RootNamespace>xpTURN.Klotho</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <!-- Third-party source: do not fail this build on its warnings. -->
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS1591;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Source generator (prebuilt DLL shipped with the Klotho package). -->
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)..\Analyzers\KlothoGenerator.dll" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The intermediate/output dirs live under this folder and hold generated .cs
      (AssemblyInfo etc.), so they must be excluded or their attributes are compiled twice.

      Note ThirdParty\LiteNetLib.v2.1.4~ is deliberately NOT excluded. The `~` there is only for
      Unity's benefit: a Unity project that consumes this repository is expected to supply
      LiteNetLib as a UPM package (com.revenantx.litenetlib), and compiling this vendored copy as
      well would give every LiteNetLib type two definitions — CS0433 at each use site. On the
      .NET side there is no package to collide with, so the glob picks it up as before and the
      server build is unaffected.

      The two copies were verified byte-identical (25 files, plain 2.1.4 with no local changes),
      so which one Unity compiles is not a behavioural choice.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)**\Json~\**\*.cs;
                      $(MSBuildThisFileDirectory)Plugins~\**\*.cs;
                      $(MSBuildThisFileDirectory).obj\**\*.cs;
                      $(MSBuildThisFileDirectory).bin\**\*.cs;
                      $(MSBuildThisFileDirectory)bin\**\*.cs" />
  </ItemGroup>

</Project>
